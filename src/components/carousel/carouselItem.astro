---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"

interface Props {
    src: ImageMetadata;
    alt: string;
    loading?: "eager" | "lazy";
    lbid?: string;
}

const { src, alt, loading, lbid } = Astro.props;
---
<div class="flex items-center justify-center w-full">
    {lbid ? (
        <a data-fslightbox={lbid} href={src.src}>
            <Image src={src} alt={alt} loading={loading ? loading : "eager"}/>
        </a>
    ) : (
        <Image src={src} alt={alt} loading={loading ? loading : "eager"}/>
    )}
</div>