---
import { Image } from 'astro:assets';

interface Props {
    name: string;
    desc: string;
    src: ImageMetadata;
    lbid: string;
}

const { name, desc, src, lbid } = Astro.props;
---

<div class="flex flex-col items-center p-3 sm:p-4 lg:transition lg:ease-in lg:duration-200 lg:hover:scale-105 rounded-lg border border-gray-600 bg-[#1D1D1D]">
    <h1 class="text-base sm:text-lg md:text-xl text-center mb-2 sm:mb-3">{name}</h1>
    <a data-fslightbox={lbid} href={src.src}>
        <Image src={src} alt={desc} class="w-full max-w-[240px] sm:max-w-[300px] md:max-w-[380px] lg:max-w-[450px] rounded">
    </a>
</div>