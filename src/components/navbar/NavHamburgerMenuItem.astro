---
interface Props {
    name: string;
    href: string;
}

const { name, href } = Astro.props;
---

<li>
    <a
        aria-controls="hamburger-menu"
        data-drawer-hide="hamburger-menu"
        class="flex items-center justify-center w-full py-2"
        href={href}>
        <span>{name}</span>
    </a>
</li>
