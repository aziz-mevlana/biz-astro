				<!-- <Person name="Betül YAĞIŞ" desc="Sponsor Sorumlusu" src={betulYagis} /> -->
				<!-- <Person name="Elifnaz DÜZCE" desc="Sponsor Sorumlusu" src={elifnazDuzce} /> -->
