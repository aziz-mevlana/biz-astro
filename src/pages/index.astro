---

<Layout title="Zirve" description="Bilişim ve İnovasyon Zirvesi 2026 - 5-6-7 Mayıs 2026 tarihlerinde Trakya Üniversitesi'nde">
	<Header />
	<div class="relative w-full">
		<div class="bg-trans w-full absolute h-[200px] top-[-85px]"></div>
	</div>
	<div class="flex flex-col mx-auto my-0 max-w-screen-2xl">
		<ContentSection href="program" title="Program">
			<div class="px-14">
					<CarouselItem src={comingSoon} alt="Bilişim ve İnovasyon Zirvesine Davetlisiniz" slot="1"/>				
			</div>

			<!-- <div class="flex flex-wrap items-center justify-evenly">
				<ProgramCard
					name="1. Gün"
					lbid="timelineOne"
					desc="Etkinliğin ilk gününün programı"
					src={dayOne}
					src2={dayOneTimeline} />
				<ProgramCard
					name="2. Gün"
					lbid="timelineTwo"
					desc="Etkinliğin ikinci gününün programı"
					src={dayTwo}
					src2={dayTwoTimeline} />
				<ProgramCard
					name="3. Gün"
					lbid="timelineThree"
					desc="Etkinliğin üçüncü gününün programı"
					src={dayThree}
					src2={dayThreeTimeline}/>
			</div> -->
		</ContentSection>
		<ContentSection href="duyurular" title="Duyurular">
			<div class="flex flex-col items-center justify-center">
				<ReactCarousel client:visible >
					<CarouselItem src={banner} alt="Bilişim ve İnovasyon Zirvesine Davetlisiniz" slot="1"/>
